; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dungeon Break"
run/main_scene="res://dungeon_break/main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[autoload]

DDD="*res://addons/zylann.debug_draw/debug_draw.gd"
GameData="*res://dungeon_break/data/game_data.gd"
EnemyDB="*res://dungeon_break/data/enemy_db.gd"
EntityManager="*res://dungeon_break/entities/entity_manager.gd"
ItemDB="*res://dungeon_break/data/item_db.gd"
GraphicsManager="*res://dungeon_break/data/graphics_manager.gd"
MusicManager="*res://dungeon_break/data/music_manager.gd"

[display]

window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

limits/global_shader_variables/buffer_size=262144
shadows/shadow_atlas/size=8192
shadows/shadow_atlas/quadrant_0_subdiv=1
shadows/shadow_atlas/quadrant_1_subdiv=1
shadows/shadow_atlas/quadrant_2_subdiv=1
shadows/shadow_atlas/quadrant_3_subdiv=1
